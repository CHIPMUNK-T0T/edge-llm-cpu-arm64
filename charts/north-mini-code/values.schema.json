{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "profile",
    "serving"
  ],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 2,
          "pattern": "^/.*"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "runtime"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileName",
            "format",
            "quantization",
            "sizeBytes",
            "sha256"
          ],
          "properties": {
            "fileName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,249}\\.gguf$"
            },
            "format": {
              "const": "GGUF"
            },
            "quantization": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "sizeBytes": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "image"
          ],
          "properties": {
            "engine": {
              "const": "llama.cpp"
            },
            "image": {
              "type": "string",
              "pattern": "^ghcr\\.io/ggml-org/llama\\.cpp:server-b[0-9]+@sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextSize",
        "threads",
        "resources",
        "probes",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "contextSize": {
          "type": "integer",
          "minimum": 1
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "$ref": "#/definitions/resourcePair"
            },
            "limits": {
              "$ref": "#/definitions/resourcePair"
            }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startup",
            "readiness",
            "liveness"
          ],
          "properties": {
            "startup": {
              "$ref": "#/definitions/probe"
            },
            "readiness": {
              "$ref": "#/definitions/probe"
            },
            "liveness": {
              "$ref": "#/definitions/probe"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "definitions": {
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
